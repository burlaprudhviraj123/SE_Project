# Database (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smart_grievance_db
DB_USERNAME=grievance_user
DB_PASSWORD=grievance_pass

# Backend Application
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET_KEY=dGhpc2lzYXZlcnlzZWNyZXRrZXlmb3JzbWFydGdpZXZhbmNlc3lzdGVtdGVzdGluZ3B1cnBvc2Vzb25seTEyMzQ1Ng==

# ANITS College Access Model
ALLOWED_EMAIL_DOMAINS=anits.edu.in
INITIAL_ADMIN_EMAIL=admin@anits.edu.in
INITIAL_ADMIN_NAME=ANITS Grievance Administrator

# Frontend & Networking
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Mail / Notifications (Mock console logger active by default)
MAIL_HOST=smtp.gmail.com
