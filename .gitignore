# ============================================================
# ResolveDesk — ANITS Campus Grievance System .gitignore
# ============================================================

# ------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.crt
*.der
id_rsa*
id_ed25519*
*.keystore
*.jks
credentials.json
service-account*.json
secrets.*
*.secret
oauth-client-*.json

# ------------------------------------------------------------
# Spring Boot / Backend Configs
# ------------------------------------------------------------
application-local.properties
application-dev.properties
application-prod.properties
application-secret.properties
Backend/src/main/resources/application-local.properties
Backend/src/main/resources/application-dev.properties
Backend/src/main/resources/application-prod.properties
Backend/src/main/resources/application-secret.properties

# ------------------------------------------------------------
# Build Outputs
# ------------------------------------------------------------
target/
Backend/target/
out/
build/
dist/
Frontend/dist/
dist-ssr/
*.class
*.jar
*.war
*.zip
*.tar.gz

# ------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------
node_modules/
Frontend/node_modules/
.m2/
dependency-reduced-pom.xml
.gradle/
gradle/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Database & Runtime Data
# ------------------------------------------------------------
*.db
*.sqlite
*.h2.db
postgres_data/

# ------------------------------------------------------------
# File Uploads & Runtime Logs
# ------------------------------------------------------------
Backend/uploads/*
!Backend/uploads/.gitkeep
uploads/*
logs/
Backend/logs/
*.log
*.log.*

# ------------------------------------------------------------
# IDE & AI Assistant Tool Folders
# ------------------------------------------------------------
.idea/
.vscode/
.freebuff/
.agent/
.claude/
.cursor/
.gemini/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~

# ------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------
# Backup & Scratch Files
# ------------------------------------------------------------
*.bak
*.tmp
*.temp
scratch/
